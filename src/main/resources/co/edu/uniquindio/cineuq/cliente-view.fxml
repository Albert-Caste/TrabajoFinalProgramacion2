<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane prefWidth="850"
            prefHeight="550"
            style="-fx-background-color: #F4F5F7;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cineuq.viewController.ClienteViewController">

    <!-- Encabezado -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-background-color: #171923;"
              prefHeight="75">

            <padding>
                <Insets left="30" right="30"/>
            </padding>

            <Label text="CinemaUQ"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #F5C518;"/>

            <Label text=" | Portal del cliente"
                   style="-fx-font-size: 15px;
                          -fx-text-fill: white;"/>

        </HBox>
    </top>

    <!-- Menú lateral -->
    <left>
        <VBox spacing="15"
              prefWidth="200"
              style="-fx-background-color: #252A36;">

            <padding>
                <Insets top="30" left="15" right="15"/>
            </padding>

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-text-fill: #F5C518;
                          -fx-font-weight: bold;
                          -fx-font-size: 13px;"/>

            <Button text="Consultar cartelera"
                    onAction="#onConsultarCartelera"
                    maxWidth="Infinity"/>

            <Button text="Comprar entradas"
                    onAction="#onComprarEntradas"
                    maxWidth="Infinity"/>

            <Button text="Mi cuenta"
                    onAction="#onMiCuenta"
                    maxWidth="Infinity"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="Cerrar sesión"
                    onAction="#onCerrarSesion"
                    maxWidth="Infinity"
                    style="-fx-background-color: #A83232;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

        </VBox>
    </left>

    <!-- Contenido central -->
    <center>
        <VBox alignment="CENTER"
              spacing="20">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <Label fx:id="lblNombreCliente"
                   text="Bienvenido"
                   style="-fx-font-size: 27px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #252A36;"/>

            <Label fx:id="lblCorreoCliente"
                   text="correo@ejemplo.com"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #777777;"/>

            <Label text="¡Nos alegra tenerte en CinemaUQ!"
                   style="-fx-font-size: 19px;
                          -fx-text-fill: #333333;"/>

            <Label text="Consulta las películas disponibles y disfruta de la mejor experiencia de cine."
                   wrapText="true"
                   maxWidth="400"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #666666;"
                   alignment="CENTER"/>

            <Label fx:id="lblMensaje"
                   text=""
                   wrapText="true"
                   style="-fx-text-fill: #B8860B;
                          -fx-font-size: 13px;"/>

        </VBox>
    </center>

    <!-- Pie de página -->
    <bottom>
        <HBox alignment="CENTER"
              prefHeight="40"
              style="-fx-background-color: #E5E7EB;">

            <Label text="CinemaUQ © 2026"
                   style="-fx-text-fill: #777777;
                          -fx-font-size: 11px;"/>

        </HBox>
    </bottom>

</BorderPane>
