<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER"
      spacing="18"
      prefWidth="450"
      prefHeight="500"
      style="-fx-background-color: #171923;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.cineuq.viewController.LoginViewController">

    <padding>
        <Insets top="35" right="45" bottom="35" left="45"/>
    </padding>

    <!-- Encabezado -->
    <Label text="CinemaUQ"
           style="-fx-font-size: 34px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #F5C518;"/>

    <Label text="Bienvenido a nuestro cine"
           style="-fx-font-size: 15px;
                  -fx-text-fill: #FFFFFF;"/>

    <VBox spacing="8" maxWidth="320">

        <Label text="Correo electrónico"
               style="-fx-text-fill: #FFFFFF;"/>

        <TextField fx:id="txtCorreo"
                   promptText="Ingrese su correo"
                   prefHeight="40"
                   style="-fx-background-radius: 6;"/>

        <Label text="Contraseña"
               style="-fx-text-fill: #FFFFFF;"/>

        <PasswordField fx:id="txtContrasena"
                       promptText="Ingrese su contraseña"
                       prefHeight="40"
                       style="-fx-background-radius: 6;"/>

    </VBox>

    <!-- Mensaje de validación -->
    <Label fx:id="lblMensaje"
           text=""
           wrapText="true"
           style="-fx-text-fill: #FF6B6B;
                  -fx-font-size: 12px;"/>

    <!-- Botón de inicio -->
    <Button text="Iniciar sesión"
            onAction="#onIniciarSesion"
            prefWidth="320"
            prefHeight="42"
            style="-fx-background-color: #F5C518;
                   -fx-text-fill: #171923;
                   -fx-font-weight: bold;
                   -fx-font-size: 14px;
                   -fx-background-radius: 6;
                   -fx-cursor: hand;"/>

    <Label text="CinemaUQ © 2026"
           style="-fx-text-fill: #888888;
                  -fx-font-size: 11px;"/>

</VBox>