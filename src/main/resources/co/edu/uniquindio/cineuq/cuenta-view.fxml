<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/11.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.cineuq.viewController.CuentaViewController"
            style="-fx-background-color: #f2f2f2;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #17202a;"
              prefHeight="65">

            <padding>
                <Insets left="25" right="25"/>
            </padding>

            <Label text="CinemaUQ"
                   style="-fx-text-fill: #d4af37;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="Mi cuenta"
                   style="-fx-text-fill: white;
                          -fx-font-size: 17px;"/>

        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="25" right="30" bottom="20" left="30"/>
            </padding>

            <Label text="Información de mi cuenta"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #17202a;"/>

            <GridPane hgap="25" vgap="12"
                      style="-fx-background-color: white;
                             -fx-background-radius: 8;
                             -fx-padding: 20;">

                <Label text="Nombre:" GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>
                <Label fx:id="lblNombre" GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Correo:" GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>
                <Label fx:id="lblCorreo" GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

                <Label text="Documento:" GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>
                <Label fx:id="lblDocumento" GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

            </GridPane>

            <Label text="Mi tarjeta virtual"
                   style="-fx-font-size: 19px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #17202a;"/>

            <HBox spacing="25"
                  style="-fx-background-color: #263746;
                         -fx-background-radius: 10;
                         -fx-padding: 20;">

                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <Label text="CINEMAUQ"
                           style="-fx-text-fill: #d4af37;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="lblNumeroTarjeta"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 16px;"/>

                    <Label text="Tarjeta virtual"
                           style="-fx-text-fill: #cccccc;"/>

                </VBox>

                <VBox spacing="8" alignment="CENTER_RIGHT">

                    <Label text="SALDO DISPONIBLE"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 12px;"/>

                    <Label fx:id="lblSaldo"
                           style="-fx-text-fill: #d4af37;
                                  -fx-font-size: 23px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Estado:"
                           style="-fx-text-fill: white;"/>

                    <Label fx:id="lblEstadoTarjeta"
                           style="-fx-text-fill: #8ee6a2;
                                  -fx-font-weight: bold;"/>

                </VBox>

            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-padding: 15;">

                <Label text="Puntos acumulados:"
                       style="-fx-font-size: 16px;"/>

                <Label fx:id="lblPuntos"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #b8860b;"/>

            </HBox>

            <Label text="Historial de movimientos"
                   style="-fx-font-size: 19px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #17202a;"/>

            <TableView fx:id="tablaMovimientos"
                       prefHeight="170">

                <columns>
                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="145"/>

                    <TableColumn fx:id="colTipo"
                                 text="Tipo"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colDescripcion"
                                 text="Descripción"
                                 prefWidth="300"/>

                    <TableColumn fx:id="colValor"
                                 text="Valor"
                                 prefWidth="130"/>
                </columns>

            </TableView>

            <Label fx:id="lblMensaje"
                   style="-fx-text-fill: #2874a6;"/>

            <HBox alignment="CENTER_RIGHT" spacing="12">

                <Button text="Actualizar"
                        onAction="#onActualizar"
                        style="-fx-background-color: #d4af37;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 9 20;"/>

                <Button text="Regresar"
                        onAction="#onRegresar"
                        style="-fx-background-color: #263746;
                               -fx-text-fill: white;
                               -fx-padding: 9 20;"/>

            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER"
              prefHeight="35"
              style="-fx-background-color: #17202a;">

            <Label text="CinemaUQ - Mi cuenta"
                   style="-fx-text-fill: white;"/>

        </HBox>
    </bottom>

</BorderPane>
